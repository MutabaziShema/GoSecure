{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://static.zohocdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://static.zohocdn.com; connect-src 'self'; form-action 'self' https://desk.zoho.com; frame-src 'self'; frame-ancestors 'self';"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/booking-form.html", "destination": "/booking-form.html" },
    { "source": "/((?!booking-form\\.html).*)", "destination": "/index.html" }
  ]
}
